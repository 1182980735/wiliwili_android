<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/search_hot_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/blbl_focus_scale"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/blblFocusStrokeColor"
    app:strokeWidth="2dp">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/search_hot_padding_h"
        android:paddingVertical="@dimen/search_hot_padding_v">

        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="@dimen/search_hot_icon_size"
            android:layout_height="@dimen/search_hot_icon_size"
            android:gravity="center"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="@dimen/search_hot_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_keyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/search_hot_icon_margin_end"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/search_hot_text_size" />

        <TextView
            android:id="@+id/tv_hot_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_search_hot_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="?attr/blblAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_hot_badge"
            android:layout_width="22dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
