<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/message_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_panel"
        android:layout_width="600dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="24dp"
        app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs_message_center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="true"
                    app:tabIndicatorColor="?attr/blblAccent"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="fixed"
                    app:tabPaddingEnd="4dp"
                    app:tabPaddingStart="4dp"
                    app:tabSelectedTextColor="?attr/blblAccent"
                    app:tabTextAppearance="@style/TextAppearance.Blbl.MessageTab"
                    app:tabTextColor="?attr/blblOnPageBackdropSecondary" />

                <ImageButton
                    android:id="@+id/btn_message_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/blblFocusBgRound"
                    android:contentDescription="关闭"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_close"
                    app:tint="?attr/blblOnPageBackdropSecondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/blblFocusStrokeFocusOnlyColor" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_messages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_message_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="30dp"
                    android:textColor="?attr/blblOnPageBackdropSecondary"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
