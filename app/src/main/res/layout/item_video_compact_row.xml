<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wiliwili_footer_key"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="8dp"
    android:stateListAnimator="@animator/blbl_focus_scale">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="63dp"
        android:background="@android:color/black">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_compact_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Rounded" />

        <TextView
            android:id="@+id/tv_compact_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_margin="5dp"
            android:background="@drawable/bg_wiliwili_video_stat_pill"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textColor="@color/blbl_text_on_media"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_compact_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="5dp"
            android:background="@drawable/bg_wiliwili_video_duration_pill"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textColor="@color/blbl_text_on_media"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_compact_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
