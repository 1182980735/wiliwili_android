<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop">

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="0dp"
        android:background="@color/blbl_surface_variant_wiliwili_light"
        android:clipChildren="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/footer_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_sidebar_user"
            android:layout_width="@dimen/sidebar_user_size"
            android:layout_height="@dimen/sidebar_user_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sidebar_user_margin_top"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:padding="1dp"
            android:stateListAnimator="@animator/blbl_focus_scale"
            android:visibility="gone"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/sym_def_app_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular"
            app:strokeColor="?attr/blblFocusStrokeColor"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/btn_sidebar_login"
            android:layout_width="@dimen/sidebar_login_size"
            android:layout_height="@dimen/sidebar_login_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sidebar_login_margin_top"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:stateListAnimator="@animator/blbl_focus_scale"
            android:text="@string/sidebar_login"
            android:textColor="?attr/blblOnPageBackdrop"
            android:textSize="@dimen/sidebar_login_text_size"
            android:visibility="gone"
            android:background="@drawable/blbl_login_circle_bg" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_sidebar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sidebar_nav_margin_top"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingVertical="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_sidebar_inbox"
            android:layout_width="@dimen/sidebar_main_settings_size"
            android:layout_height="@dimen/sidebar_main_settings_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:contentDescription="消息"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/blbl_focus_scale"
            android:padding="@dimen/sidebar_main_settings_padding"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wiliwili_inbox_centered"
                app:tint="?attr/blblOnPageBackdropSecondary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_sidebar_settings"
            android:layout_width="@dimen/sidebar_main_settings_size"
            android:layout_height="@dimen/sidebar_main_settings_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/sidebar_settings_margin_bottom"
            android:contentDescription="@string/tab_settings"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/blbl_focus_scale"
            android:padding="@dimen/sidebar_main_settings_padding"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wiliwili_ico_setting"
                app:tint="?attr/blblOnPageBackdropSecondary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/blblContentBackground"
        app:layout_constraintBottom_toTopOf="@id/footer_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/footer_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_wiliwili_footer_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="18dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_wiliwili_battery" />

        <TextClock
            android:id="@+id/footer_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:includeFontPadding="false"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="17sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y 搜索     B 返回     A 确定"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />
    </LinearLayout>

    <include
        android:id="@+id/user_info_overlay"
        layout="@layout/dialog_user_info"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
