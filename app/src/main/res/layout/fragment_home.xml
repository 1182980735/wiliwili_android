<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop">

    <blbl.cat3399.core.ui.UserScaleTabLayout
        android:id="@+id/tab_layout"
        style="@style/Widget.Blbl.TabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@android:color/transparent"
        android:focusable="false"
        app:layout_constraintEnd_toStartOf="@id/home_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_search"
        android:layout_width="330dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/blbl_focus_scale"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/tab_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tab_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/tab_search"
                android:src="@drawable/wiliwili_header_search"
                app:tint="?attr/blblAccent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="搜索你感兴趣的视频"
                android:textColor="?attr/blblOnPageBackdropSecondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_wiliwili_page_badge"
                android:gravity="center"
                android:text="Y"
                android:textColor="?attr/blblAccent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/blblContentBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
