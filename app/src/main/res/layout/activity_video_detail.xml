<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/sidebar_settings_size"
        android:layout_height="@dimen/sidebar_settings_size"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:background="?attr/blblFocusBgRound"
        android:contentDescription="@string/search_backspace"
        android:elevation="12dp"
        android:focusable="true"
        android:padding="@dimen/sidebar_settings_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/blblOnPageBackdropSecondary" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/detail_split_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_wiliwili_detail_surface"
        app:layout_constraintBottom_toTopOf="@id/footer_bar"
        app:layout_constraintEnd_toStartOf="@id/detail_split_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:padding="8dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_wiliwili_detail_surface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/footer_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detail_split_guideline"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/detail_right_tabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:id="@+id/detail_tab_comment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_wiliwili_footer_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_tab_comment_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="评论"
                    android:textColor="?attr/blblAccent"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/detail_tab_comment_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/blblAccent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_tab_parts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_wiliwili_footer_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_tab_parts_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="分集"
                    android:textColor="?attr/blblOnPageBackdropSecondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/detail_tab_parts_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/blblAccent"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_tab_recommend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_wiliwili_footer_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_tab_recommend_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="推荐"
                    android:textColor="?attr/blblOnPageBackdropSecondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/detail_tab_recommend_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/blblAccent"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_tab_upload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_wiliwili_footer_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_tab_upload_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="投稿"
                    android:textColor="?attr/blblOnPageBackdropSecondary"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/detail_tab_upload_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/blblAccent"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/blblFocusStrokeFocusOnlyColor" />

        <FrameLayout
            android:id="@+id/right_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/comments_panel_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <include layout="@layout/include_video_comments_panel_content" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recommendations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_detail_extra"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_detail_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:textColor="?attr/blblOnPageBackdropSecondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_wiliwili_footer_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="18dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_wiliwili_battery" />

        <TextClock
            android:id="@+id/footer_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:includeFontPadding="false"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="17sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/footer_prev_tab"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:visibility="gone"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="LA 左Tab"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/footer_next_tab"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:visibility="gone"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="RA 右Tab"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/footer_refresh"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="X 刷新"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/footer_search"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Y 搜索"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/footer_back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="B 返回"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/footer_confirm"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wiliwili_footer_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="A 确定"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
