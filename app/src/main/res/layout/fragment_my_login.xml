<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop"
    android:padding="@dimen/wiliwili_page_padding_h">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/wiliwili_page_radius_panel"
        app:cardElevation="0dp"
        app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor"
        app:strokeWidth="@dimen/wiliwili_page_stroke"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/wiliwili_cn_xfangfang_wiliwili_s"
                android:background="@drawable/bg_wiliwili_page_badge"
                android:padding="18dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular"
                app:strokeColor="?attr/blblAccent"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/wiliwili_page_gap"
                android:text="@string/my_need_login"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/wiliwili_page_gap_small"
                android:text="登录后可同步历史、收藏与追番"
                android:textColor="?attr/blblOnPageBackdropSecondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="?attr/blblAccent"
                android:paddingHorizontal="28dp"
                android:text="@string/my_qr_login"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/wiliwili_page_radius_card" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
