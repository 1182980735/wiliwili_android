<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/blbl_accent_wiliwili_container" />
            <stroke android:width="1dp" android:color="@color/blbl_accent_wiliwili" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/blbl_accent_wiliwili_weak" />
            <stroke android:width="1dp" android:color="@color/blbl_accent_wiliwili" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke android:width="1dp" android:color="@color/blbl_line_wiliwili_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
