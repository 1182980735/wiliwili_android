<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblAccentContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/blblAccent" />
            <corners android:radius="@dimen/wiliwili_video_action_corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblAccentWeak" />
            <stroke
                android:width="1dp"
                android:color="?attr/blblAccent" />
            <corners android:radius="@dimen/wiliwili_video_action_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC202124" />
            <corners android:radius="@dimen/wiliwili_video_action_corner_radius" />
        </shape>
    </item>
</selector>
