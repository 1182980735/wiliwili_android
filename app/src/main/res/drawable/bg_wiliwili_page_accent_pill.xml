<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblAccentContainer" />
            <stroke android:width="@dimen/wiliwili_page_focus_stroke" android:color="?attr/blblAccent" />
            <corners android:radius="@dimen/wiliwili_page_radius_pill" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblAccentWeak" />
            <corners android:radius="@dimen/wiliwili_page_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblAccentContainer" />
            <corners android:radius="@dimen/wiliwili_page_radius_pill" />
        </shape>
    </item>
</selector>
