<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FF2D2D2D" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="5dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF36B45A" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
